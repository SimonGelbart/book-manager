<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:TomeRaider.Application"
             xmlns:vm="using:TomeRaider.Presentation"
             x:Class="TomeRaider.Presentation.MainView"
             x:DataType="vm:MainViewModel">
  <ScrollViewer>
    <StackPanel Margin="28" Spacing="12" MaxWidth="900">
      <TextBlock FontSize="28" FontWeight="Bold" Text="Tome Raider" />
      <TextBlock Text="Raid. Hoard. Read." />
      <TextBlock Text="Browse your EPUB collection and keep reading information beside it." />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Select folder and import" Click="SelectFolder" />
        <Button Content="Import saved folder" Click="ImportSavedFolder" />
        <Button Content="Clear collection" Click="RequestClearCollection" />
      </StackPanel>
      <Border IsVisible="{Binding IsClearCollectionConfirmationVisible}"
              BorderBrush="Orange"
              BorderThickness="1"
              Padding="8">
        <StackPanel Spacing="6">
          <TextBlock Text="Clear all saved works, metadata, tags, copies, and personal reading records?"
                     TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Clear all saved works" Click="ConfirmClearCollection" />
            <Button Content="Cancel" Click="CancelClearCollection" />
          </StackPanel>
        </StackPanel>
      </Border>
      <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
      <TextBlock FontWeight="Bold" Text="Needs review" />
      <ItemsControl ItemsSource="{Binding Reviews}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ImportReviewViewModel">
            <Border BorderBrush="DarkOrange" BorderThickness="1" Padding="8" Margin="0,0,0,6">
              <StackPanel Spacing="4">
                <TextBlock FontWeight="Bold" Text="{Binding FileName, StringFormat='Review: {0}'}" />
                <TextBlock Text="{Binding Location, StringFormat='Location: {0}'}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Title, StringFormat='Title: {0}'}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Author, StringFormat='Author: {0}'}" />
                <TextBlock Text="{Binding Ao3WorkId, StringFormat='AO3 work: {0}'}" />
                <TextBlock Text="{Binding SourceUrl, StringFormat='Source: {0}'}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Description, StringFormat='Description: {0}'}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding AuthorNotes, StringFormat='Author notes: {0}'}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding WordCount, StringFormat='Words: {0}'}" />
                <TextBlock Text="{Binding Chapters, StringFormat='Chapters: {0}'}" />
                <TextBlock Text="{Binding Completion, StringFormat='Completion: {0}'}" />
                <TextBlock Text="{Binding Tags, StringFormat='Tags: {0}'}" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding TagGroups}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TagGroupViewModel">
                      <Expander Header="{Binding Header}" IsExpanded="False">
                        <ItemsControl ItemsSource="{Binding Values}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <TextBlock Margin="8,0,0,0" Text="{Binding}" TextWrapping="Wrap" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Expander>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" />
                <Button Content="Identify as a new work" Click="ResolveReviewAsNew" HorizontalAlignment="Left" />
                <TextBlock FontWeight="Bold" Text="Possible existing works" />
                <ItemsControl ItemsSource="{Binding Candidates}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ImportReviewCandidateViewModel">
                      <Border BorderBrush="Gray" BorderThickness="1" Padding="6" Margin="0,0,0,4">
                        <StackPanel Spacing="2">
                          <TextBlock FontWeight="Bold" Text="{Binding Title}" />
                          <TextBlock Text="{Binding Author, StringFormat='Author: {0}'}" />
                          <TextBlock Text="{Binding ReadingStatus, StringFormat='Reading status: {0}'}" />
                          <TextBlock Text="{Binding PersonalNoteDisplay}" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding CopyCount, StringFormat='Copies: {0}'}" />
                          <Button Content="Associate with this work"
                                  Tag="{Binding}"
                                  Click="ResolveReviewToExisting"
                                  HorizontalAlignment="Left" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Grid ColumnDefinitions="2*,3*" ColumnSpacing="16">
        <StackPanel Grid.Column="0" Spacing="8">
          <TextBlock FontWeight="Bold" Text="Collection (all saved works)" />
          <ListBox ItemsSource="{Binding Works}"
                   x:Name="WorksList"
                   SelectedItem="{Binding SelectedWork, Mode=OneWay}"
                   SelectionChanged="SelectWork"
                   MinHeight="180">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:WorkSummaryViewModel">
                <StackPanel Margin="4" Spacing="2">
                  <TextBlock FontWeight="Bold" Text="{Binding Title}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Author, StringFormat='Author: {0}'}" />
                  <TextBlock Text="{Binding ReadingStatus, StringFormat='Reading status: {0}'}" />
                  <TextBlock Text="{Binding WordCount, StringFormat='Words: {0}'}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="6">
          <TextBlock FontWeight="Bold" Text="Work details" />
          <TextBlock FontSize="22" FontWeight="Bold" Text="{Binding WorkDetails.Title}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding WorkDetails.Author, StringFormat='Author: {0}'}" />
          <TextBlock Text="{Binding WorkDetails.Completion, StringFormat='Story completion (AO3): {0}'}" />
          <TextBlock Text="{Binding WorkDetails.WordCount, StringFormat='Words: {0}'}" />
          <TextBlock Text="{Binding WorkDetails.Chapters, StringFormat='Chapters: {0}'}" />
          <TextBlock Text="{Binding WorkDetails.SourceUrl, StringFormat='Source: {0}'}" TextWrapping="Wrap" />
          <TextBlock Text="Description" FontWeight="Bold" />
          <TextBlock Text="{Binding WorkDetails.Description}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding WorkDetails.AuthorNotes, StringFormat='Author notes: {0}'}" TextWrapping="Wrap" />
          <TextBlock Text="Tags" FontWeight="Bold" />
          <ItemsControl ItemsSource="{Binding WorkDetails.TagGroups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TagGroupViewModel">
                <Expander Header="{Binding Header}" IsExpanded="False">
                  <ItemsControl ItemsSource="{Binding Values}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Margin="8,0,0,0" Text="{Binding}" TextWrapping="Wrap" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Expander>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="Copies" FontWeight="Bold" />
          <ItemsControl ItemsSource="{Binding WorkDetails.Copies}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="app:CatalogueCopy">
                <StackPanel Margin="0,0,0,4">
                  <TextBlock Text="{Binding DisplayName, StringFormat='File: {0}'}" />
                  <TextBlock Text="{Binding Reference, StringFormat='Location: {0}'}" TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock FontWeight="Bold" Text="Personal reading record" />
          <TextBox PlaceholderText="Personal note" Text="{Binding PersonalNote}" AcceptsReturn="True" MinHeight="80" />
          <Button Content="Save as Read" Click="SaveReading" HorizontalAlignment="Left" />
        </StackPanel>
      </Grid>
      <TextBlock FontWeight="Bold" Text="Latest scan results (current import)" />
      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="app:ImportItemResult">
            <Border BorderBrush="Gray" BorderThickness="1" Padding="8" Margin="0,0,0,6">
              <StackPanel Spacing="4">
                <TextBlock FontWeight="Bold" Text="{Binding DisplayText}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Work.Author, StringFormat='Author: {0}'}" />
                <TextBlock Text="{Binding Metadata.Ao3WorkId, StringFormat='AO3 work: {0}'}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
